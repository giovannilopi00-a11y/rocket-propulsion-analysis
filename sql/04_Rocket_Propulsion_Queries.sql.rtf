\f0\fs24 \cf0 -- ============================================================\
-- ROCKET PROPULSION PROJECT\
-- SQL ANALYSIS\
-- Chemical vs Nuclear Thermal Propulsion (NTP)\
-- ============================================================\
\
\
-- ============================================================\
-- 1. VISUALIZZAZIONE DELLE PRIME SIMULAZIONI\
-- ============================================================\
\
SELECT *\
FROM simulations\
LIMIT 10;\
\
\
-- ============================================================\
-- 2. FILTRO DELLE CONFIGURAZIONI NTP\
-- ============================================================\
\
SELECT *\
FROM simulations\
WHERE system = 'NTP'\
LIMIT 10;\
\
\
-- ============================================================\
-- 3. NTP CON SPINTA MINIMA DI 100 kN\
-- ORDINATI PER IMPULSO SPECIFICO\
-- ============================================================\
\
SELECT *\
FROM simulations\
WHERE system = 'NTP'\
  AND thrust_n >= 100000\
ORDER BY specific_impulse DESC\
LIMIT 10;\
\
\
-- ============================================================\
-- 4. STESSA ANALISI CON SOLO LE COLONNE PRINCIPALI\
-- ============================================================\
\
SELECT\
    system,\
    pc_mpa,\
    tc_k,\
    expansion_ratio,\
    mass_flow_kg_s,\
    thrust_n,\
    specific_impulse\
FROM simulations\
WHERE system = 'NTP'\
  AND thrust_n >= 100000\
ORDER BY specific_impulse DESC\
LIMIT 10;\
\
\
-- ============================================================\
-- 5. STATISTICHE MEDIE PER SISTEMA PROPULSIVO\
-- ============================================================\
\
SELECT\
    system,\
    AVG(specific_impulse) AS avg_isp,\
    MAX(specific_impulse) AS max_isp,\
    AVG(thrust_n) AS avg_thrust,\
    AVG(mass_flow_kg_s) AS avg_mass_flow\
FROM simulations\
GROUP BY system;\
\
\
-- ============================================================\
-- 6. MINIMI, MASSIMI E NUMERO DI SIMULAZIONI\
-- ============================================================\
\
SELECT\
    system,\
    MIN(specific_impulse) AS min_isp,\
    MIN(mass_flow_kg_s) AS min_mass_flow,\
    MAX(thrust_n) AS max_thrust,\
    COUNT(*) AS number_of_simulations\
FROM simulations\
GROUP BY system;\
\
\
-- ============================================================\
-- 7. CONFIGURAZIONI PARETO ORDINATE PER Isp\
-- ============================================================\
\
SELECT\
    system,\
    pc_mpa,\
    tc_k,\
    expansion_ratio,\
    mass_flow_kg_s,\
    thrust_n,\
    specific_impulse\
FROM pareto\
ORDER BY specific_impulse DESC;\
\
\
-- ============================================================\
-- 8. CONFIGURAZIONE PARETO CON PORTATA MINIMA\
-- VINCOLO: SPINTA >= 100 kN\
-- ============================================================\
\
SELECT\
    pc_mpa,\
    tc_k,\
    expansion_ratio,\
    mass_flow_kg_s,\
    thrust_n,\
    specific_impulse\
FROM pareto\
WHERE thrust_n >= 100000\
ORDER BY mass_flow_kg_s ASC\
LIMIT 1;\
\
\
-- ============================================================\
-- 9. RIEPILOGO FINALE CHEMICAL vs NTP\
-- ============================================================\
\
SELECT\
    system,\
    COUNT(*) AS configurations,\
    ROUND(AVG(specific_impulse), 2) AS avg_isp,\
    ROUND(MAX(specific_impulse), 2) AS max_isp,\
    ROUND(AVG(thrust_n) / 1000, 2) AS avg_thrust_kn,\
    ROUND(MIN(mass_flow_kg_s), 2) AS min_mass_flow\
FROM simulations\
GROUP BY system;\
\
\
-- ============================================================\
-- 10. CONTROLLO STRUTTURA DELLA TABELLA\
-- ============================================================\
\
PRAGMA table_info(simulations);}